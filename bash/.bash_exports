export DIGITALOCEAN_ENABLE_BETA=1

# Setup Krew plugins
export PATH=~/.krew/bin:${PATH}
export HISTCONTROL=ignoreboth:erasedups

# Adding Go bin to path
export PATH="${HOME}/go/bin:$PATH"
# Adding Python 3.9 bin to path
export PATH="${PATH}:${HOME}/Library/Python/3.9/bin"

export EDITOR='vim'

# Only use en_GB.UTF-8 when the locale is available, otherwise keep the locale
# of the system (containers often only ship C.UTF-8).
if locale -a 2>/dev/null | grep -qi '^en_GB\.utf-\?8$'; then
	export LANG='en_GB.UTF-8'
	export LC_ALL='en_GB.UTF-8'
fi

## GoLang setup....
if command -v go >/dev/null 2>&1; then
	export GOPATH=$(go env GOPATH)
	export PATH=$PATH:$(go env GOPATH)/bin
fi

# GPG TTY Fix
export GPG_TTY=$(tty)

# Silence zsh warning
export BASH_SILENCE_DEPRECATION_WARNING=1

export FZF_DEFAULT_OPTS='--height 40% --layout=reverse --border --cycle'
